{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbot.local/spec/memory.schema.json",
  "title": "Qbot Memory Record",
  "type": "object",
  "required": ["schema_version", "memory_id", "state", "scope", "content", "provenance", "trust", "created_at"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "memory_id": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["CANDIDATE", "PROMOTED", "SUPERSEDED", "REJECTED", "EXPIRED"] },
    "scope": {
      "type": "string",
      "enum": ["SYSTEM_POLICY", "USER_PERSONA", "CONTACT_PROFILE", "CONVERSATION_MEMORY", "TASK_MEMORY"]
    },
    "owner_id": { "type": ["string", "null"] },
    "conversation_id": { "type": ["string", "null"] },
    "task_id": { "type": ["string", "null"] },
    "content": { "type": "string", "minLength": 1 },
    "entities": { "type": "array", "items": { "type": "string" } },
    "importance": { "type": "number", "minimum": 0, "maximum": 1 },
    "trust": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": {
      "type": "object",
      "required": ["source_type"],
      "properties": {
        "source_type": { "type": "string", "enum": ["SYSTEM", "USER_SELF", "CONTACT", "AGENT_INFERENCE", "IMPORT"] },
        "source_message_id": { "type": ["string", "null"] },
        "source_event_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "valid_from": { "type": ["string", "null"], "format": "date-time" },
    "valid_to": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
