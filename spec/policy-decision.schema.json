{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbot.local/spec/policy-decision.schema.json",
  "title": "Qbot Policy Decision",
  "type": "object",
  "required": ["schema_version", "decision_id", "proposal_id", "risk_class", "outcome", "reasons", "created_at"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "decision_id": { "type": "string", "minLength": 1 },
    "proposal_id": { "type": "string", "minLength": 1 },
    "risk_class": { "type": "string", "enum": ["R0", "R1", "R2", "R3"] },
    "outcome": { "type": "string", "enum": ["ALLOW", "ALLOW_AUDIT", "REQUIRE_HUMAN", "DENY"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "required_capabilities": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
