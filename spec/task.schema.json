{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbot.local/spec/task.schema.json",
  "title": "Qbot Durable Task",
  "type": "object",
  "required": ["schema_version", "task_id", "conversation_id", "goal", "status", "phase", "steps", "version", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "parent_task_id": { "type": ["string", "null"] },
    "goal": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["NEW", "PLANNING", "READY", "RUNNING", "WAITING_USER", "PAUSED", "FAILED", "CANCELLED", "COMPLETED"]
    },
    "phase": { "type": "string" },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "sequence", "description", "status"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 0 },
          "description": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "WAITING_USER", "CANCELLED"]
          },
          "result": { "type": ["string", "null"] },
          "error": { "type": ["string", "null"] },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "completed_at": { "type": ["string", "null"], "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": ["string", "null"] },
    "writer_epoch": { "type": "integer", "minimum": 0, "default": 0 },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
