{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbot.local/spec/checkpoint.schema.json",
  "title": "Qbot Task Checkpoint",
  "type": "object",
  "required": ["schema_version", "checkpoint_id", "task_id", "task_version", "summary", "completed_step_ids", "pending_step_ids", "created_at"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "checkpoint_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "agent_run_id": { "type": ["string", "null"] },
    "task_version": { "type": "integer", "minimum": 1 },
    "summary": { "type": "string" },
    "completed_step_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "pending_step_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "current_step_id": { "type": ["string", "null"] },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": ["string", "null"] },
    "context_digest": { "type": ["string", "null"] },
    "writer_epoch": { "type": "integer", "minimum": 0, "default": 0 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
