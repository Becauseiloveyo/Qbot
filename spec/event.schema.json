{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbot.local/spec/event.schema.json",
  "title": "Qbot Normalized Event",
  "type": "object",
  "required": ["schema_version", "event_id", "fingerprint", "platform", "account_id", "conversation_id", "event_type", "occurred_at", "received_at"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "minLength": 16 },
    "platform": { "type": "string", "enum": ["qq", "mock"] },
    "transport": { "type": "string" },
    "account_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "sender_id": { "type": ["string", "null"] },
    "platform_message_id": { "type": ["string", "null"] },
    "event_type": {
      "type": "string",
      "enum": ["MESSAGE_RECEIVED", "MESSAGE_UPDATED", "MESSAGE_RECALLED", "TRANSPORT_STATUS"]
    },
    "message_type": {
      "type": ["string", "null"],
      "enum": ["private", "group", "system", null]
    },
    "text": { "type": ["string", "null"] },
    "content_ref": { "type": ["string", "null"] },
    "reply_to_message_id": { "type": ["string", "null"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" },
    "raw_ref": { "type": ["string", "null"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
